{
  "name": "@minsky/dashboard",
  "version": "1.0.0",
  "description": "Web dashboard for visualizing Minsky economic models",
  "private": true,
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --cwd api dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build"
  }
}
